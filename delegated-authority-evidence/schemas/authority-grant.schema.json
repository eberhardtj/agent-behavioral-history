{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-behavioral-history:delegated-authority-evidence:authority-grant:1.0",
  "title": "Authority Grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grantId",
    "subject",
    "permittedOperations",
    "redelegationAllowed",
    "mayModifyOwnAuthority"
  ],
  "properties": {
    "grantId": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "parentGrantId": {
      "type": ["string", "null"]
    },
    "permittedOperations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "currency": {
      "type": ["string", "null"]
    },
    "maxAmount": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "approvedCounterpartiesOnly": {
      "type": "boolean"
    },
    "redelegationAllowed": {
      "type": "boolean"
    },
    "mayModifyOwnAuthority": {
      "type": "boolean"
    },
    "purpose": {
      "type": ["string", "null"]
    },
    "validFrom": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "validUntil": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
